---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { BASE, STATUS_META } from '../lib/utils';

const places = await getCollection('places');

const points = await Promise.all(
  places.map(async (p) => {
    const photo = p.data.photos[0];
    const thumb = photo
      ? await getImage({ src: photo.src, width: Math.min(photo.src.width, 480), format: 'webp' })
      : null;
    return {
      title: p.data.title,
      country: p.data.country,
      motivation: p.data.motivation,
      status: p.data.status,
      coords: p.data.coordinates,
      href: `${BASE}/places/${p.id}/`,
      photo: thumb?.src ?? null,
    };
  })
);
---

<Base title="地图 · Wanderlist">
  <main class="map-page">
    <div class="map-bar container">
      <h1>足迹地图</h1>
      <div class="legend">
        {Object.values(STATUS_META).map((meta) => (
          <span class="legend-item">
            <i style={`background:${meta.color}`}></i>
            {meta.label}
          </span>
        ))}
      </div>
    </div>
    <div id="map" aria-label="目的地地图" data-points={JSON.stringify(points)}></div>
  </main>
</Base>

<style>
  .map-page {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .map-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 1.3rem;
    padding-bottom: 1.1rem;
  }

  .map-bar h1 {
    font-size: 1.5rem;
  }

  .legend {
    display: flex;
    gap: 1.1rem;
    font-size: 0.86rem;
    color: var(--ink-soft);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .legend-item i {
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
    display: inline-block;
    border: 2px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 0 1px rgba(60, 44, 26, 0.25);
  }

  #map {
    flex: 1;
    min-height: 460px;
    height: calc(100vh - 220px);
    border-top: 1px solid var(--line);
    background: var(--paper-deep);
  }

  /* 底图稍微降低饱和度、偏暖一点，和站点的纸张配色更协调 */
  #map :global(.leaflet-tile-pane) {
    filter: saturate(0.82) sepia(0.12);
  }

  /* Leaflet 弹窗排版（全局作用于 leaflet 注入的 DOM） */
  :global(.leaflet-popup-content-wrapper) {
    background: var(--card);
    color: var(--ink);
    border-radius: 12px;
    box-shadow: 0 12px 30px -12px rgba(60, 44, 26, 0.45);
    font-family: var(--sans);
  }

  :global(.leaflet-popup-content) {
    margin: 14px 18px;
    line-height: 1.65;
  }

  :global(.popup-photo) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 8px;
    margin: 2px 0 10px;
    background: var(--paper-deep);
  }

  /* 加上 .leaflet-popup-content 前缀，才能盖过 Leaflet 自带的段落间距和蓝色链接 */
  :global(.leaflet-popup-content .popup-title) {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 2px;
  }

  :global(.leaflet-popup-content .popup-title small) {
    font-family: var(--sans);
    font-weight: 400;
    color: var(--ink-soft);
    margin-left: 0.4em;
  }

  :global(.leaflet-popup-content .popup-motivation) {
    margin: 0 0 6px;
    color: var(--primary-deep);
    font-size: 0.88rem;
  }

  :global(.leaflet-container a.popup-link) {
    font-size: 0.85rem;
    color: var(--primary);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    #map {
      height: calc(100vh - 250px);
    }
  }
</style>

<script>
  // Leaflet 随站点一起打包，不再依赖 unpkg 等外部 CDN
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { wgs84ToGcj02 } from '../lib/geo.js';
  import { STATUS_META, type Status } from '../lib/utils';

  interface Point {
    title: string;
    country: string;
    motivation: string;
    status: Status;
    coords: [number, number];
    href: string;
    photo: string | null;
  }

  const el = document.getElementById('map')!;
  const points: Point[] = JSON.parse(el.dataset.points ?? '[]');
  const map = L.map(el, { scrollWheelZoom: true, worldCopyJump: true });

  // 底图：默认用高德（国内访问快、中文地名、不需要 key），加载不出来时自动换成 OpenStreetMap。
  // 高德用国内的 GCJ-02 坐标，国内地点要先转换；OpenStreetMap 直接用原始的 WGS-84 坐标。
  const bases = [
    {
      gcj: true,
      layer: L.tileLayer(
        'https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}',
        {
          subdomains: '1234',
          maxZoom: 18,
          attribution: '&copy; <a href="https://www.amap.com/" target="_blank" rel="noopener">高德地图</a>',
        }
      ),
    },
    {
      gcj: false,
      layer: L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> 贡献者',
      }),
    },
  ];
  let active = 0;

  const position = (p: Point): [number, number] =>
    bases[active].gcj ? wgs84ToGcj02(p.coords[0], p.coords[1]) : p.coords;

  /** 用 DOM 构建弹窗，文字一律走 textContent，不会被当成 HTML 解析 */
  function popup(p: Point): HTMLElement {
    const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    };
    const wrap = document.createElement('div');
    if (p.photo) {
      const img = make('img', 'popup-photo');
      img.src = p.photo;
      img.alt = p.title;
      wrap.append(img);
    }
    const title = make('p', 'popup-title', p.title);
    title.append(make('small', undefined, `${p.country} · ${STATUS_META[p.status].label}`));
    const link = make('a', 'popup-link', '查看档案 →');
    link.href = p.href;
    wrap.append(title, make('p', 'popup-motivation', `「${p.motivation}」`), link);
    return wrap;
  }

  const markers = points.map((p) => ({
    p,
    marker: L.circleMarker(position(p), {
      radius: 9,
      color: '#fffdf8',
      weight: 2.5,
      fillColor: STATUS_META[p.status].color,
      fillOpacity: 0.95,
    })
      .addTo(map)
      .bindPopup(() => popup(p), { minWidth: p.photo ? 240 : 50, maxWidth: 260 })
      .bindTooltip(p.title, { direction: 'top', offset: [0, -8] }),
  }));

  /** 启用第 i 个底图；一张图块都没加载出来（报错或 8 秒没响应）就换下一个 */
  function useBase(i: number) {
    bases[active].layer.remove();
    active = i;
    const { layer } = bases[i];
    layer.addTo(map);
    for (const { p, marker } of markers) marker.setLatLng(position(p));
    let loaded = 0;
    let failed = 0;
    const fallback = () => {
      if (active === i && loaded === 0 && i + 1 < bases.length) useBase(i + 1);
    };
    layer.on('tileload', () => loaded++);
    layer.on('tileerror', () => {
      if (++failed >= 4) fallback();
    });
    setTimeout(fallback, 8000);
  }

  if (points.length > 0) {
    map.fitBounds(
      points.map(position),
      { padding: [60, 60], maxZoom: 6 }
    );
  } else {
    map.setView([30, 105], 3);
  }
  useBase(0);
</script>
