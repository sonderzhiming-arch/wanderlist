---
/**
 * 全站共用的照片查看器。每页放一个即可：
 * 页面上任何 [data-gallery] 容器里的 a[data-lightbox] 都会在这里打开，
 * 同一容器里的照片可以左右切换。链接的 href 是大图地址，脚本失效时点击会直接打开大图。
 */
---

<dialog class="lightbox" aria-label="照片查看器">
  <div class="lb-stage">
    <button class="lb-btn lb-close" type="button" aria-label="关闭">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <button class="lb-btn lb-prev" type="button" aria-label="上一张">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <figure class="lb-figure">
      <img class="lb-img" alt="" decoding="async" />
      <figcaption class="lb-caption" aria-live="polite">
        <span class="lb-text"></span>
        <span class="lb-meta">
          <span class="lb-count"></span>
          <span class="lb-byline"></span>
          <a class="lb-source" target="_blank" rel="noopener noreferrer">原图 ↗</a>
        </span>
      </figcaption>
    </figure>
    <button class="lb-btn lb-next" type="button" aria-label="下一张">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(30, 24, 19, 0.97);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #f5ecdd;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  :global(html.lb-open) {
    overflow: hidden;
  }

  .lb-stage {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 3.4rem 1.2rem 1.4rem;
    touch-action: pan-y pinch-zoom;
  }

  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }

  .lb-img {
    display: block;
    max-width: 100%;
    border-radius: 6px;
    background: rgba(255, 253, 248, 0.05);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.7);
    transition: opacity 0.25s ease;
  }

  .lb-img.is-loading {
    opacity: 0.35;
  }

  .lb-caption {
    max-width: 760px;
    text-align: center;
    line-height: 1.6;
  }

  .lb-text {
    display: block;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .lb-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem 0.9rem;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: rgba(245, 236, 221, 0.68);
  }

  .lb-meta span:empty {
    display: none;
  }

  .lb-source {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lb-source:hover {
    color: #f5ecdd;
  }

  .lb-btn {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 253, 248, 0.1);
    color: #f5ecdd;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .lb-btn:hover {
    background: rgba(255, 253, 248, 0.22);
  }

  .lb-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lb-btn[hidden] {
    visibility: hidden;
  }

  .lb-btn svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lb-close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
  }

  @media (max-width: 640px) {
    .lb-stage {
      grid-template-columns: minmax(0, 1fr);
      padding: 3.6rem 0.5rem 1rem;
    }

    .lb-prev,
    .lb-next {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 40px;
      height: 40px;
      background: rgba(30, 24, 19, 0.45);
    }

    .lb-prev {
      left: 0.4rem;
    }

    .lb-next {
      right: 0.4rem;
    }
  }
</style>

<script>
  interface Item {
    url: string;
    w: number;
    h: number;
    caption: string;
    byline: string;
    source: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');

  if (dialog) {
    const $ = <T extends Element>(sel: string) => dialog.querySelector<T>(sel)!;
    const stage = $<HTMLElement>('.lb-stage');
    const img = $<HTMLImageElement>('.lb-img');
    const text = $<HTMLElement>('.lb-text');
    const count = $<HTMLElement>('.lb-count');
    const bylineEl = $<HTMLElement>('.lb-byline');
    const source = $<HTMLAnchorElement>('.lb-source');
    const prevBtn = $<HTMLButtonElement>('.lb-prev');
    const nextBtn = $<HTMLButtonElement>('.lb-next');

    let items: Item[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const read = (a: HTMLAnchorElement): Item => ({
      url: a.href,
      w: Number(a.dataset.w) || 1600,
      h: Number(a.dataset.h) || 1000,
      caption: a.dataset.caption ?? '',
      byline: a.dataset.byline ?? '',
      source: a.dataset.source ?? '',
    });

    // 按视口大小算出图片显示尺寸，图片加载前就占好位置，切换时不跳动
    function fit() {
      const item = items[index];
      if (!item) return;
      const narrow = window.innerWidth <= 640;
      const maxW = Math.min(window.innerWidth - (narrow ? 16 : 170), item.w);
      const maxH = window.innerHeight - (narrow ? 190 : 200);
      const scale = Math.min(maxW / item.w, maxH / item.h, 1);
      img.style.width = `${Math.round(item.w * scale)}px`;
      img.style.height = `${Math.round(item.h * scale)}px`;
    }

    function show(i: number) {
      index = (i + items.length) % items.length;
      const item = items[index];
      if (img.getAttribute('src') !== item.url) {
        img.classList.add('is-loading');
        img.src = item.url;
      }
      img.alt = item.caption;
      fit();
      text.textContent = item.caption;
      count.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
      bylineEl.textContent = item.byline;
      source.hidden = !item.source;
      if (item.source) source.href = item.source;
      prevBtn.hidden = nextBtn.hidden = items.length < 2;
      // 预加载前后两张
      if (items.length > 1) {
        for (const step of [1, -1]) {
          new Image().src = items[(index + step + items.length) % items.length].url;
        }
      }
    }

    img.addEventListener('load', () => img.classList.remove('is-loading'));

    document.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('[data-gallery] a[data-lightbox]');
      if (!link || event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; // 让用户能在新标签页打开大图
      event.preventDefault();
      const links = Array.from(
        link.closest('[data-gallery]')!.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')
      );
      items = links.map(read);
      opener = link;
      show(links.indexOf(link));
      dialog.showModal();
      document.documentElement.classList.add('lb-open');
    });

    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));
    $<HTMLButtonElement>('.lb-close').addEventListener('click', () => dialog.close());

    // 点图片以外的空白处关闭
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === stage) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (items.length < 2) return;
      if (event.key === 'ArrowRight') show(index + 1);
      else if (event.key === 'ArrowLeft') show(index - 1);
      else return;
      event.preventDefault();
    });

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lb-open');
      opener?.focus({ preventScroll: true });
    });

    window.addEventListener('resize', () => {
      if (dialog.open) fit();
    });

    // 手机上左右滑动切换
    let startX = 0;
    let startY = 0;
    let tracking = false;
    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      tracking = true;
      startX = event.clientX;
      startY = event.clientY;
    });
    stage.addEventListener('pointerup', (event) => {
      if (!tracking) return;
      tracking = false;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (items.length > 1 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        show(index + (dx < 0 ? 1 : -1));
      }
    });
    stage.addEventListener('pointercancel', () => (tracking = false));
  }
</script>
